# Trever Radar VPS 排程(docs/31 §2;時刻沿用現行 Worker 時間表,遷移時刻意不改排程)
# 安裝:crontab -e 貼入以下內容(把 /home/huang 換成實際家目錄)。
# VPS 系統時區須為 Asia/Taipei(WP-B0 已確認);cronie 亦可用 CRON_TZ=Asia/Taipei 雙保險。
# 全部輸出集中 ~/radar-cron.log;看狀態:tail -f ~/radar-cron.log

CRON_TZ=Asia/Taipei

# 每日輪(週一–五)
# 一律 bash 呼叫:避免 git pull 後腳本失去 +x → cron Permission denied(2026-08-26 事故)。
10 14 * * 1-5  bash /home/huang/trever-radar/vps/scripts/daily-market.sh      >> /home/huang/radar-cron.log 2>&1
0  15 * * 1-5  bash /home/huang/trever-radar/vps/scripts/daily-tpex-quotes.sh >> /home/huang/radar-cron.log 2>&1
10 16 * * 1-5  bash /home/huang/trever-radar/vps/scripts/daily-insti.sh       >> /home/huang/radar-cron.log 2>&1
40 17 * * 1-5  bash /home/huang/trever-radar/vps/scripts/daily-branches.sh    >> /home/huang/radar-cron.log 2>&1
# 融資主輪 21:20(TWSE ~21:00 產製;留約 20 分緩衝)。分點第二輪改 22:00,避免搶 lock。
20 21 * * 1-5  bash /home/huang/trever-radar/vps/scripts/daily-margin.sh      >> /home/huang/radar-cron.log 2>&1
0  22 * * 1-5  bash /home/huang/trever-radar/vps/scripts/daily-branches.sh    >> /home/huang/radar-cron.log 2>&1

# Disabled candidate — all-market TWSE+TPEx warrant branches need 6–8h at
# sleep=1.0; VPS free space was only 7.6GB on 2026-08-28 (<20GB gate).
# Enable only after 1/5-day + 3-trading-day PoC, capacity approval, and a
# separately approved slot.  This PoC script never exports or deploys data.
# 0 0 * * 2-6  bash /home/huang/trever-radar/vps/scripts/daily-warrant-branches-poc.sh >> /home/huang/radar-cron.log 2>&1

# 深歷史增量(每日;已拉深自動跳過,近零請求)
10 1 * * *     bash /home/huang/trever-radar/vps/scripts/data-backfill.sh  >> /home/huang/radar-cron.log 2>&1

# 週備份(週六;checkpoint + integrity_check + gzip + Google Drive)
0 5 * * 6      bash /home/huang/trever-radar/vps/scripts/weekly-backup.sh  >> /home/huang/radar-cron.log 2>&1

# 盤中訊號雷達 worker(docs/24 Part A;08:50 啟動、13:35 自動收工)
# 一次性前置:docker build -t radar-worker pipeline/intraday;
# pipeline/intraday/.env 填好六個變數(見 pipeline/intraday/.env.example,
# 含 2026-07-13 Access 上線後必填的 CF_ACCESS_CLIENT_ID/SECRET)。
50 8 * * 1-5   docker run --rm --name radar-worker --env-file /home/huang/trever-radar/pipeline/intraday/.env radar-worker >> /home/huang/radar-worker.log 2>&1

# 回補容器保護(docs/33):單實例 flock;@reboot + 每 5 分保活
@reboot        bash /home/huang/trever-radar/vps/scripts/bf-cron-guard.sh >> /home/huang/bf-cron-guard.log 2>&1
*/5 * * * *    pgrep -f 'vps/scripts/bf-cron-guard.sh' >/dev/null || bash /home/huang/trever-radar/vps/scripts/bf-cron-guard.sh >> /home/huang/bf-cron-guard.log 2>&1

# 歷史回補管家(docs/35):單寫者＋Exit 自啟＋完成 ntfy;與 guard 並存
# 目前 VPS 優先權證:環境 BF_ORDER=warrant,branches(見 ~/bf-supervisor.env 或 crontab)
@reboot        bash /home/huang/trever-radar/vps/scripts/bf-supervisor.sh >> /home/huang/bf-supervisor.log 2>&1
*/10 * * * *   pgrep -f 'vps/scripts/bf-supervisor.sh' >/dev/null || bash /home/huang/trever-radar/vps/scripts/bf-supervisor.sh >> /home/huang/bf-supervisor.log 2>&1

# 回補中途動態上線(docs/33):03/09/12/20 — 一律只 export(預設略過 stats,避免 1.7G RAM OOM)
# 腳本內再次檢查 quiet 窗與 radar-db.lock;無 bf 容器則 noop
0 3,9,12,20 * * *  bash /home/huang/trever-radar/vps/scripts/mid-backfill-publish.sh >> /home/huang/radar-cron.log 2>&1

# 分點排行＋分數(docs/33 S2 / docs/35):每日 00:05 — pause bf → stats → 帳本 → 分點×個股分位 → scores → export
#
# 2026-09-04 由 23:30 改為 00:05。原因:`e47a175`(fix(vps): run margin at 21:20
# after TWSE publish)把平日兩段安靜窗 `2055..2200` + `2235..2320` 合併成一段
# `2115..2330`,而 `in_radar_quiet_window` 是閉區間 `2115 <= hhmm <= 2330`,
# 剛好蓋住 cron 在 23:30:01 觸發 → hhmm=2330 → 落在窗內,
# **平日必定略過**。log 佐證:8/29(六)、8/30(日)有 done,8/27、8/28、8/31、9/01、
# 9/02、9/03 全部只有 start 沒有 done——這支作業自該窗設定以來平日從未執行。
# 週末窗(六 0055-0230 與 0450-0730、日 0055-0400)不含 23:30,所以只有週末跑得完。
#
# 為何是 00:05:唯一真正的衝突是 22:00 那輪的尾巴(實測 8/31 23:53、9/03 約 00:12、
# 9/08 過了 00:05 還在持鎖 → 整夜略過)。這個衝突改用「等」處理,不用「搬」:腳本已
# 改成 `flock -w 3000`,最晚 00:55 放棄並吹 high。挪時段只會換一組要避的鄰居。
# 注意:舊註解說 00:05 是為了「趕在 01:10 deep backfill 之前」——今天已不成立,
# 本作業實測 79–90 分鐘,每夜本來就壓過 01:10,deep backfill 也一直在讓路。
#
# 為何是 2-6(週二~週六)而非每天:帳本 as_of 取 MAX(date) FROM daily_prices,
# 週日與週一兩輪都會解析到週五那個 as_of,而同 PK 是覆蓋——只會把週六那次的
# computed_at 換掉,不新增任何一天。砍掉這兩天之後,「還會發生的略過」每一次
# 都確實等於失去一個帳本日期,notify 也就不會再狼來了。
5 0 * * 2-6    bash /home/huang/trever-radar/vps/scripts/safe-branch-stats.sh >> /home/huang/radar-cron.log 2>&1

# 資券 240 日回補(docs/34 A4):週日 02:30 — 一次性(DONE flag);避開 daily 窗
30 2 * * 0     bash /home/huang/trever-radar/vps/scripts/backfill-margin.sh >> /home/huang/radar-cron.log 2>&1

# TDCC 大戶週更(docs/34 B1 / docs/35):週六 06:30(備份 05:00 之後)
30 6 * * 6     bash /home/huang/trever-radar/vps/scripts/weekly-tdcc.sh >> /home/huang/radar-cron.log 2>&1

# 董監持股月更(docs/34 §4.6):每月 16 日 07:00(申報截止後)
0 7 16 * *     bash /home/huang/trever-radar/vps/scripts/monthly-directors.sh >> /home/huang/radar-cron.log 2>&1

# 磁碟清理(不動 radar.db):docker dangling + log trim + npm cache;低於 4G 則 ntfy
40 7 * * *     bash /home/huang/trever-radar/vps/scripts/disk-cleanup.sh >> /home/huang/disk-cleanup.log 2>&1
