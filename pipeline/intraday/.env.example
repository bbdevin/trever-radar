# docs/24 Part A — 盤中訊號雷達 worker 專用金鑰模板。
# 複製為 pipeline/intraday/.env 後填值;.env 已被 .gitignore 涵蓋,絕不 commit、絕不進 GitHub secrets。
# 完整部署步驟見 docs/vps_backfill_plan.md Step 5 + docs/31 WP-B7。

# Fugle MarketData API key(官方名稱;盤中 worker 與 WP-H3 當日分時共用,不另開 RADAR_FUGLE_TOKEN)
FUGLE_API_KEY=
# 基本用戶免費方案 WS 訂閱上限 5;付費方案可調高(見 https://developer.fugle.tw/docs/pricing/)
FUGLE_WS_MAX_SUBSCRIBE=5

# Supabase(既有專案,與 watchlist 功能共用;service_role key 才能寫入、繞過 RLS)
# Dashboard → Settings → API → service_role
SUPABASE_URL=
SUPABASE_KEY=

# radar.json 來源(WP-B3 後固定自訂網域;pages.dev 已無 /data)
RADAR_JSON_URL=https://radar.techtrever.com/data/radar.json

# WP-B7:/data Worker 門鎖。與 Cloudflare wrangler secret RADAR_SERVICE_KEY 必須同一把。
# 產生:openssl rand -hex 32
# 寫入 Worker:cd ~/trever-radar/cloudflare-data-worker && npx wrangler secret put RADAR_SERVICE_KEY
RADAR_SERVICE_KEY=

# Cloudflare Access service token(過渡期;Access Application 關閉後可留空)
# Access 還在時盤中 worker 仍需這兩行才能穿過 Access,再靠上面的 RADAR_SERVICE_KEY 過 Worker。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
