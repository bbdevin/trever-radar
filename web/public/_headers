# Cloudflare Pages. SW must not be cached, otherwise update prompt never fires.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Build output is content-hashed, so it never changes under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Icons are not hashed; one week keeps a replaced icon from sticking around too long.
/icons/*
  Cache-Control: public, max-age=604800
