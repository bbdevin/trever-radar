  "definitions": {
    "drop": "100 x close(s, e) <= 97 x open(s, e)",
    "e": "the 2nd market day after t in D (every date with any daily_prices row); computed from the calendar, never read from a stored column",
    "entry_open_at_limit_proxy": "report only: open(s, e) x 1000 >= close(s, v) x 1095, raw prices; an ex-dividend e understates it",
    "event": "a signal day whose previous futures trading day (full futures calendar) is not a signal day of the same stock; runs are found on the full calendar BEFORE the exclusion window X = [2026-09-18, 2026-10-02] is applied",
    "hit": "100 x close(s, e) >= 103 x open(s, e), raw prices, same row, decimal comparison",
    "pools": "eligible (s, d): s a stock; d a futures day <= as_of, not R4, not in X; some contract seen unrefused with flag False; no contract flagged (any S) and none refused R2b_immaterial; S(s, d) established False; (s, e(d)) passes R1-R2. Days next to events are deliberately NOT removed (§3.1)",
    "sigma_n": "max(1, sqrt(h_P + d_P - (h_P - d_P)^2 / n))",
    "sigma_p": "max(1, sqrt(n * p_hat * (1 - p_hat))), p_hat = h_P / n (seed_result)",
    "signal_day": "t a futures trading day <= as_of, not an R4 settlement-window day; at least one contract on s seen by the docs/38 rule unrefused with flag = True, AND S(s, t) established False; unknown S is not a signal day; one per stock",
    "visible_day": "report only: v(t) = the 1st market day after t; its open-to-close >= 3% / <= -3% counts can never change the verdict (§3.6)"
  },
